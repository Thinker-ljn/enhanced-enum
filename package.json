{
  "name": "enhanced-enum",
  "version": "0.4.1",
  "type": "module",
  "description": "a enhanced enum with typescript intellisense",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  },
  "keywords": [
    "enum",
    "typescript"
  ],
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "main": "./dist/enhanced-enum.cjs",
  "module": "./dist/enhanced-enum.es.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/enhanced-enum.es.js",
      "require": "./dist/enhanced-enum.cjs"
    }
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "build": "vite build",
    "release": "release-it",
    "release:dry-run": "release-it --dry-run --no-git.requireUpstream --no-git.push --no-npm.publish"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": "eslint --fix"
  },
  "author": "Thinker-ljn",
  "license": "ISC",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@release-it/conventional-changelog": "^12.0.2",
    "@types/node": "^22.20.3",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.12.0",
    "lint-staged": "^17.5.1",
    "prettier": "^3.9.6",
    "release-it": "^21.0.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "vite-plugin-dts": "^5.1.0",
    "vitest": "^5.0.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Thinker-ljn/enhanced-enum.git"
  },
  "homepage": "https://github.com/Thinker-ljn/enhanced-enum#readme"
}
